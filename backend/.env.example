# Environment variables
NODE_ENV=development
PORT=3000

# Database
MONGODB_URI=mongodb://localhost:27017/bazi-fortune
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d

# AI Service (NVIDIA NIM miniMAX / 智谱 GLM / OpenAI)
# Choose provider: 'nim_minimax' (NVIDIA NIM) or 'zhipu' (智谱GLM - FREE) or 'openai'
LLM_PROVIDER=nim_minimax
LLM_API_KEY=nvapi-your_nvidia_nim_api_key_here
LLM_MODEL=minimaxai/minimax-m2.1

# Legacy zhipu support
# LLM_PROVIDER=zhipu
# LLM_API_KEY=your_zhipu_api_key_here
# LLM_MODEL=glm-4-flash

# Frontend URL
FRONTEND_URL=http://localhost:8080

# Email service (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_password

# File uploads
UPLOAD_MAX_SIZE=10485760
UPLOAD_PATH=./uploads

# Rate limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# WeChat Mini Program
WECHAT_APP_ID=your_wechat_app_id_here
WECHAT_APP_SECRET=your_wechat_app_secret_here

# WeChat Pay (微信支付)
WECHAT_MCH_ID=your_wechat_mch_id_here
WECHAT_PAY_KEY=your_wechat_pay_key_here
WECHAT_PAY_CERT_PATH=
WECHAT_PAY_NOTIFY_URL=https://your-domain.com/api/payment/notify