/* AI解读页面样式 */

/* 付费墙 */
.paywall {
  position: relative;
  margin: 30rpx 0;
  border-radius: 16rpx;
  overflow: hidden;
}

.paywall-overlay {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: linear-gradient(180deg, #fff8f0, #fff);
  border: 2rpx dashed #d4a574;
  border-radius: 16rpx;
}

.paywall-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.paywall-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.paywall-desc {
  font-size: 24rpx;
  color: #888;
  text-align: center;
  padding: 0 40rpx;
  margin-bottom: 20rpx;
}

.paywall-price {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.price-original {
  font-size: 26rpx;
  color: #bbb;
  text-decoration: line-through;
}

.price-current {
  font-size: 40rpx;
  font-weight: bold;
  color: #e53935;
}

.paywall-btn {
  min-width: 300rpx;
}

/* 免费预览限制3行 */
.preview-clamp {
  max-height: 130rpx;
  overflow: hidden;
  position: relative;
}

.preview-clamp::after {
  content: '...';
  position: absolute;
  bottom: 0;
  right: 0;
  padding-left: 40rpx;
  background: linear-gradient(to right, transparent, #fff 50%);
  color: #999;
}

.model-info {
  background: linear-gradient(135deg, #e8f0fe, #f0e6ff);
  border-radius: 8rpx;
  padding: 12rpx 20rpx;
  margin-bottom: 24rpx;
}

.model-label {
  font-size: 24rpx;
  color: #5b6abf;
}

.analysis-section {
  margin-bottom: 30rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.analysis-section:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.subsection-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #8B4513;
  margin-bottom: 16rpx;
}

.analysis-content {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
}

.tags {
  margin-top: 16rpx;
}

.fortune-meter {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.meter-label {
  font-size: 24rpx;
  color: #999;
  width: 120rpx;
}

.meter-bar {
  flex: 1;
  height: 16rpx;
  background: #eee;
  border-radius: 8rpx;
  overflow: hidden;
  margin: 0 16rpx;
}

.meter-fill {
  height: 100%;
  background: linear-gradient(90deg, #8B4513, #D2691E);
  border-radius: 8rpx;
  transition: width 0.6s ease;
}

.meter-score {
  font-size: 24rpx;
  color: #8B4513;
  font-weight: bold;
  width: 100rpx;
  text-align: right;
}

.health-tips {
  margin-top: 16rpx;
}

.tip-item {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.tip-icon {
  margin-right: 12rpx;
}

.tip-text {
  font-size: 26rpx;
  color: #666;
}

.luck-timeline {
  margin-top: 16rpx;
}

.timeline-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.timeline-age {
  font-size: 26rpx;
  color: #8B4513;
  font-weight: bold;
  width: 100rpx;
}

.timeline-luck {
  flex: 1;
  font-size: 26rpx;
  color: #555;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: #f9f9f9;
}

.timeline-luck.good {
  background: #e8f5e9;
  color: #2e7d32;
}

.timeline-luck.excellent {
  background: #fff3e0;
  color: #e65100;
}

.timeline-luck.stable {
  background: #e3f2fd;
  color: #1565c0;
}

.suggestions {
  margin-top: 16rpx;
}

.suggestion-category {
  margin-bottom: 20rpx;
}

.category-title {
  font-size: 28rpx;
  color: #8B4513;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.suggestion-item {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.suggestion-icon {
  margin-right: 8rpx;
}

.suggestion-text {
  font-size: 26rpx;
  color: #666;
}

.confidence-badge {
  display: inline-block;
  background: #e8f5e9;
  color: #2e7d32;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: normal;
  margin-left: 16rpx;
  vertical-align: middle;
}

/* 聊天样式 */
.chat-messages {
  max-height: 600rpx;
  overflow-y: auto;
  margin-bottom: 20rpx;
}

.message-item {
  display: flex;
  margin-bottom: 20rpx;
}

.message-item.ai {
  flex-direction: row;
}

.message-item.user {
  flex-direction: row-reverse;
}

.message-avatar {
  width: 64rpx;
  height: 64rpx;
  margin: 0 16rpx;
}

.avatar-emoji {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 40rpx;
  border-radius: 50%;
  background: #f0e6d3;
}

.message-avatar image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.message-content {
  max-width: 70%;
}

.message-text {
  font-size: 28rpx;
  color: #333;
  background: #f5f5f5;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  line-height: 1.6;
}

.message-item.user .message-text {
  background: #8B4513;
  color: white;
}

.message-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.quick-questions {
  margin-bottom: 20rpx;
}

.quick-title {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.quick-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.quick-btn {
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  background: #fff8f0;
  color: #8B4513;
  border: 1rpx solid #d4a574;
  border-radius: 30rpx;
  line-height: 1.4;
}

.chat-input {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.chat-input .input-field {
  flex: 1;
}

.send-btn {
  background: #8B4513;
  color: white;
  font-size: 28rpx;
  padding: 16rpx 32rpx;
  border-radius: 8rpx;
  border: none;
  min-width: 120rpx;
}

.send-btn[disabled] {
  background: #ccc;
}

/* AI分析等待卡片 */
.loading-card {
  text-align: center;
  padding: 60rpx 30rpx;
}

.ai-loading-inline {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ai-loading-inline .ai-brain {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.ai-loading-inline .loading-text {
  font-size: 32rpx;
  color: #8B4513;
  font-weight: bold;
  margin-top: 20rpx;
}

.ai-loading-inline .loading-subtext {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 加载遮罩（保留给其他场景） */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.loading-content {
  background: white;
  border-radius: 24rpx;
  padding: 60rpx 80rpx;
  text-align: center;
}

.ai-loading {
  margin-bottom: 24rpx;
}

.ai-brain {
  font-size: 80rpx;
}

.loading-dots {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  background: #8B4513;
  border-radius: 50%;
  animation: dotPulse 1.2s infinite ease-in-out;
}

.dot:nth-child(2) {
  animation-delay: 0.2s;
}

.dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes dotPulse {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.5; }
  40% { transform: scale(1); opacity: 1; }
}

.loading-text {
  display: block;
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}

.loading-subtext {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 命理师 */
.master-list {
  margin-top: 20rpx;
}

.master-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.master-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
}

.master-avatar-emoji {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
  background: #f0e6d3;
  line-height: 96rpx;
  text-align: center;
  flex-shrink: 0;
}

.master-info {
  flex: 1;
}

.master-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.master-title {
  font-size: 24rpx;
  color: #999;
}

.master-rating {
  margin-top: 4rpx;
}

.rating-star {
  color: #ff9800;
  font-size: 22rpx;
}

.rating-score {
  font-size: 22rpx;
  color: #ff9800;
  margin-left: 8rpx;
}

.consult-price {
  text-align: center;
}

.price {
  display: block;
  font-size: 28rpx;
  color: #e53935;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.consult-btn {
  font-size: 22rpx;
  padding: 8rpx 24rpx;
}

.action-buttons {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 0 40rpx;
}

.action-buttons button {
  flex: 1;
}

.info-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}
