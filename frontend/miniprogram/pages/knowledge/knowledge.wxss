.container { padding: 30rpx; background: #F5F5DC; min-height: 100vh; padding-bottom: 40rpx; }
.page-title { font-size: 40rpx; font-weight: bold; color: #8B4513; text-align: center; margin-bottom: 30rpx; }
.card { background: #fff; border-radius: 20rpx; padding: 40rpx; box-shadow: 0 4rpx 20rpx rgba(139,69,19,0.1); margin-bottom: 24rpx; }

/* 分类标签 */
.category-scroll { margin-bottom: 24rpx; }
.category-tabs { display: flex; padding: 0 4rpx; gap: 16rpx; white-space: nowrap; }
.cat-tab {
  display: inline-block; padding: 16rpx 32rpx; border-radius: 40rpx;
  font-size: 28rpx; color: #8B4513; background: #fff;
  border: 2rpx solid #D2B48C; white-space: nowrap;
  box-shadow: 0 2rpx 8rpx rgba(139,69,19,0.1);
}
.cat-tab.active { background: #8B4513; color: #fff; border-color: #8B4513; }

/* 内容卡片 */
.content-card { padding: 40rpx; }
.content-title { font-size: 36rpx; font-weight: bold; color: #8B4513; margin-bottom: 16rpx; }
.content-desc { font-size: 26rpx; color: #666; line-height: 1.6; margin-bottom: 32rpx;
  padding: 20rpx; background: #FFF8DC; border-radius: 12rpx; border-left: 6rpx solid #8B4513; }

/* 天干 */
.tiangan-item { display: flex; align-items: flex-start; padding: 24rpx 0; border-bottom: 1rpx solid #f0e8d8; gap: 24rpx; }
.tiangan-item:last-child { border-bottom: none; }
.tg-char { font-size: 64rpx; font-weight: bold; min-width: 80rpx; text-align: center; line-height: 1; }
.tg-info { flex: 1; }
.tg-meta { display: flex; align-items: center; gap: 16rpx; margin-bottom: 12rpx; }
.tg-wuxing { font-size: 26rpx; font-weight: bold; background: rgba(139,69,19,0.1); padding: 4rpx 16rpx; border-radius: 20rpx; }
.tg-yinyang { font-size: 24rpx; color: #999; }
.tg-desc { font-size: 26rpx; color: #555; line-height: 1.6; }

/* 地支 */
.dizhi-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.dizhi-item { background: #FFF8DC; border-radius: 16rpx; padding: 24rpx; border: 2rpx solid #e8dcc8; }
.dz-char { font-size: 56rpx; font-weight: bold; text-align: center; }
.dz-shengxiao { text-align: center; font-size: 24rpx; color: #8B4513; margin: 4rpx 0; }
.dz-time { text-align: center; font-size: 20rpx; color: #999; margin-bottom: 8rpx; }
.dz-wuxing { text-align: center; font-size: 22rpx; font-weight: bold; background: rgba(139,69,19,0.1); padding: 4rpx 12rpx; border-radius: 20rpx; display: inline-block; margin: 0 auto 12rpx; width: fit-content; }
.dz-desc { font-size: 22rpx; color: #666; line-height: 1.5; }

/* 五行 */
.wx-item { padding: 28rpx 0; border-bottom: 1rpx solid #f0e8d8; }
.wx-item:last-child { border-bottom: none; }
.wx-header { display: flex; align-items: center; gap: 16rpx; margin-bottom: 16rpx; }
.wx-symbol { font-size: 40rpx; }
.wx-name { font-size: 40rpx; font-weight: bold; }
.wx-shengke { display: flex; gap: 12rpx; margin-left: auto; }
.sheng-tag { font-size: 22rpx; background: #e8f5e9; color: #2e7d32; padding: 4rpx 12rpx; border-radius: 20rpx; }
.ke-tag { font-size: 22rpx; background: #fde8e8; color: #c62828; padding: 4rpx 12rpx; border-radius: 20rpx; }
.wx-desc { font-size: 26rpx; color: #555; line-height: 1.6; margin-bottom: 12rpx; }
.wx-ganzhi { font-size: 24rpx; color: #8B4513; }
.gz-label { color: #aaa; }

/* 十神 */
.ss-item { padding: 24rpx 0; border-bottom: 1rpx solid #f0e8d8; }
.ss-item:last-child { border-bottom: none; }
.ss-header { display: flex; align-items: center; gap: 20rpx; margin-bottom: 12rpx; }
.ss-badge { width: 60rpx; height: 60rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 22rpx; font-weight: bold; color: #fff; text-align: center; line-height: 60rpx; }
.ss-sibling { background: #ff9800; }
.ss-output { background: #4caf50; }
.ss-wealth { background: #2196f3; }
.ss-power { background: #f44336; }
.ss-resource { background: #9c27b0; }
.ss-name { font-size: 32rpx; font-weight: bold; color: #333; }
.ss-detail { font-size: 26rpx; color: #555; line-height: 1.6; }
.ss-small-desc { display: none; }

/* 大运流年 */
.dy-item { padding: 24rpx; background: #FFF8DC; border-radius: 12rpx; margin-bottom: 16rpx; border-left: 6rpx solid #8B4513; }
.dy-title { font-size: 30rpx; font-weight: bold; color: #8B4513; margin-bottom: 12rpx; }
.dy-desc { font-size: 26rpx; color: #555; line-height: 1.7; }

/* 神煞 */
.shensha-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.sha-item { background: linear-gradient(135deg, #FFF8DC, #F5F5DC); border-radius: 16rpx; padding: 24rpx;
  border: 2rpx solid #D2B48C; }
.sha-symbol { font-size: 32rpx; font-weight: bold; color: #8B4513; background: rgba(139,69,19,0.15);
  width: 64rpx; height: 64rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center;
  margin-bottom: 12rpx; text-align: center; line-height: 64rpx; }
.sha-name { font-size: 28rpx; font-weight: bold; color: #333; margin-bottom: 10rpx; }
.sha-desc { font-size: 22rpx; color: #666; line-height: 1.5; }
