/**app.wxss**/
/* 全局样式 */
page {
  background-color: #f5f5dc;
  font-family: -apple-system-font, Helvetica Neue, Helvetica, sans-serif;
}

/* 通用容器 */
.container {
  padding: 20rpx;
  min-height: 100vh;
}

/* 卡片样式 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

/* 按钮样式 */
.btn-primary {
  background: linear-gradient(135deg, #8B4513, #A0522D);
  color: white;
  border: none;
  border-radius: 50rpx;
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.btn-secondary {
  background: transparent;
  color: #8B4513;
  border: 2rpx solid #8B4513;
  border-radius: 50rpx;
  padding: 22rpx 46rpx;
  font-size: 30rpx;
}

.btn-ghost {
  background: transparent;
  color: #666;
  border: 2rpx solid #ddd;
  border-radius: 50rpx;
  padding: 22rpx 46rpx;
  font-size: 30rpx;
}

/* 输入框样式 */
.input-group {
  margin-bottom: 30rpx;
}

.input-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  font-weight: bold;
}

.input-field {
  background: #fff;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 30rpx;
  color: #333;
}

.input-field:focus {
  border-color: #8B4513;
}

/* 标题样式 */
.page-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #8B4513;
  text-align: center;
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  position: relative;
}

.section-title::before {
  content: '';
  position: absolute;
  left: -20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 32rpx;
  background: #8B4513;
  border-radius: 4rpx;
}

/* 列表样式 */
.list-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 16rpx;
  border-left: 6rpx solid #8B4513;
}

.list-item:last-child {
  margin-bottom: 0;
}

/* 标签样式 */
.tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  border-radius: 24rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}

.tag-primary {
  background: #8B4513;
  color: #fff;
}

.tag-success {
  background: #4CAF50;
  color: #fff;
}

.tag-warning {
  background: #FF9800;
  color: #fff;
}

.tag-info {
  background: #2196F3;
  color: #fff;
}

/* 分隔线 */
.divider {
  height: 2rpx;
  background: #e0e0e0;
  margin: 40rpx 0;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 28rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
  color: #999;
}

.empty-state image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
  opacity: 0.5;
}

/* 浮动按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  background: linear-gradient(135deg, #8B4513, #A0522D);
  color: white;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(139, 69, 19, 0.3);
  z-index: 999;
}

/* 模态框 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
}

.modal-content {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: white;
  border-radius: 24rpx;
  padding: 40rpx;
  min-width: 600rpx;
  max-width: 80%;
}

/* 响应式设计 */
@media (max-width: 375px) {
  .container {
    padding: 16rpx;
  }

  .card {
    padding: 24rpx;
    border-radius: 12rpx;
  }
}

/* 动画 */
.fade-in {
  animation: fadeIn 0.3s ease-in-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.slide-up {
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

/* 八字排盘特殊样式 */
.bazi-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin: 20rpx 0;
}

.bazi-pillar {
  background: linear-gradient(135deg, #F5F5DC, #FFF8DC);
  border: 2rpx solid #8B4513;
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
}

.tiangan {
  font-size: 36rpx;
  font-weight: bold;
  color: #8B4513;
  margin-bottom: 8rpx;
}

.dizhi {
  font-size: 32rpx;
  color: #A0522D;
}

.wuxing {
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
}

/* 主题颜色变量 */
:root {
  --primary-color: #8B4513;
  --secondary-color: #A0522D;
  --background-color: #F5F5DC;
  --card-color: #ffffff;
  --text-primary: #333333;
  --text-secondary: #666666;
  --border-color: #e0e0e0;
}