.container { padding: 24rpx; background: #F5F5DC; min-height: 100vh; padding-bottom: 40rpx; }
.card { background: #fff; border-radius: 20rpx; padding: 32rpx; box-shadow: 0 4rpx 20rpx rgba(139,69,19,0.1); margin-bottom: 24rpx; }

/* 月份导航 */
.month-nav {
  display: flex; align-items: center; justify-content: center;
  gap: 24rpx; margin-bottom: 24rpx; padding: 20rpx;
  background: #fff; border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(139,69,19,0.1);
}
.nav-btn {
  font-size: 48rpx; color: #8B4513; width: 64rpx; height: 64rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%; background: #FFF8DC;
}
.month-title { font-size: 34rpx; font-weight: bold; color: #8B4513; flex: 1; text-align: center; }
.today-btn {
  font-size: 26rpx; color: #fff; background: #8B4513;
  padding: 10rpx 24rpx; border-radius: 20rpx;
}

/* 日历 */
.calendar-card { padding: 20rpx; }
.week-header { display: grid; grid-template-columns: repeat(7, 1fr); margin-bottom: 8rpx; }
.week-cell { text-align: center; font-size: 24rpx; color: #999; padding: 12rpx 0; font-weight: bold; }
.week-cell.sun { color: #e53935; }
.week-cell.sat { color: #1565c0; }

.week-row { display: grid; grid-template-columns: repeat(7, 1fr); }
.day-cell {
  min-height: 100rpx; display: flex; flex-direction: column; align-items: center;
  justify-content: center; border-radius: 12rpx; padding: 8rpx 4rpx;
  cursor: pointer;
}
.day-cell:active { background: rgba(139,69,19,0.1); }
.day-cell.empty { }
.day-cell.today { background: rgba(139,69,19,0.12); }
.day-cell.selected { background: #8B4513 !important; }
.day-cell.selected .day-num { color: #fff !important; }
.day-cell.selected .day-lunar { color: rgba(255,255,255,0.8) !important; }

.day-num { font-size: 30rpx; font-weight: bold; color: #333; }
.day-cell.today .day-num { color: #8B4513; }
.day-lunar { font-size: 18rpx; color: #999; margin-top: 4rpx; }
.day-lunar.term { color: #e53935; font-weight: bold; }

/* 详情卡片 */
.detail-card { }
.detail-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 28rpx; padding-bottom: 24rpx; border-bottom: 2rpx solid #f0e8d8; }
.detail-date { display: flex; align-items: center; gap: 20rpx; }
.detail-day { font-size: 80rpx; font-weight: bold; color: #8B4513; line-height: 1; }
.detail-meta { display: flex; flex-direction: column; gap: 8rpx; }
.detail-meta text { font-size: 26rpx; color: #555; }
.term-badge { background: #e53935; color: #fff; font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 20rpx; display: inline-block; }
.detail-lunar { text-align: right; }
.lunar-text { display: block; font-size: 30rpx; color: #8B4513; font-weight: bold; }
.shengxiao-text { display: block; font-size: 24rpx; color: #999; margin-top: 8rpx; }

/* 干支行 */
.ganzhi-row { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.gz-pill { flex: 1; background: #FFF8DC; border-radius: 12rpx; padding: 16rpx; text-align: center; border: 2rpx solid #D2B48C; }
.gz-label { display: block; font-size: 22rpx; color: #999; margin-bottom: 8rpx; }
.gz-val { font-size: 32rpx; font-weight: bold; color: #8B4513; }

/* 冲煞 */
.chong-row { display: flex; align-items: center; gap: 12rpx; background: #fff3f3; border-radius: 12rpx; padding: 16rpx 20rpx; margin-bottom: 20rpx; }
.chong-label { font-size: 24rpx; color: #fff; background: #e53935; padding: 4rpx 12rpx; border-radius: 8rpx; }
.chong-val { font-size: 28rpx; font-weight: bold; color: #e53935; }
.chong-tip { font-size: 22rpx; color: #999; flex: 1; }

/* 宜忌 */
.yiji-section { margin-bottom: 20rpx; }
.yi-title { font-size: 28rpx; font-weight: bold; color: #2e7d32; margin-bottom: 12rpx; }
.ji-title { font-size: 28rpx; font-weight: bold; color: #c62828; margin-bottom: 12rpx; }
.yi-tags, .ji-tags { display: flex; flex-wrap: wrap; gap: 12rpx; }
.yi-tag {
  font-size: 24rpx; padding: 8rpx 20rpx; border-radius: 20rpx;
  background: #e8f5e9; color: #2e7d32; border: 1rpx solid #a5d6a7;
}
.ji-tag {
  font-size: 24rpx; padding: 8rpx 20rpx; border-radius: 20rpx;
  background: #fde8e8; color: #c62828; border: 1rpx solid #ef9a9a;
}
