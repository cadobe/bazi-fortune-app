.container {
  padding: 30rpx;
  background: #F5F5DC;
  min-height: 100vh;
}
.page-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #8B4513;
  text-align: center;
  margin-bottom: 40rpx;
}
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(139,69,19,0.1);
}
.loading-wrap {
  text-align: center;
  padding: 80rpx 0;
}
.loading-text {
  font-size: 28rpx;
  color: #8B4513;
  margin-top: 20rpx;
}
.two-chart-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 30rpx;
}
.mini-chart {
  flex: 1;
  text-align: center;
}
.chart-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 10rpx;
}
.chart-person-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #3d1a00;
  margin-bottom: 10rpx;
}
.bazi-str {
  font-size: 28rpx;
  color: #8B4513;
  letter-spacing: 4rpx;
}
.vs-badge {
  font-size: 36rpx;
  font-weight: bold;
  color: #A0522D;
}
.result-card {
  text-align: center;
}
.score-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  background: linear-gradient(135deg, #8B4513, #A0522D);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0 auto 30rpx;
}
.score-num {
  font-size: 56rpx;
  font-weight: bold;
  color: #fff;
}
.score-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
}
.result-level {
  font-size: 36rpx;
  font-weight: bold;
  color: #8B4513;
  margin-bottom: 20rpx;
}
.result-summary {
  font-size: 28rpx;
  color: #555;
  line-height: 1.6;
  margin-bottom: 30rpx;
}
.tips-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #8B4513;
  margin-bottom: 16rpx;
  text-align: left;
}
.tip-item {
  font-size: 28rpx;
  color: #555;
  padding: 10rpx 0;
  text-align: left;
}
.empty-state {
  text-align: center;
  padding: 100rpx 0;
}
.empty-text {
  font-size: 30rpx;
  color: #999;
}
