<view class="container">
  <view class="page-title">命理社区</view>

  <!-- Tab栏 -->
  <view class="tab-bar">
    <view class="tab-item {{activeTab === item.id ? 'active' : ''}}"
          wx:for="{{tabs}}"
          wx:key="id"
          bindtap="switchTab"
          data-tab="{{item.id}}">
      {{item.name}}
    </view>
  </view>

  <!-- 帖子列表 -->
  <view class="post-list">
    <view class="post-card" wx:for="{{posts}}" wx:key="id" bindtap="openPostDetail" data-post="{{item}}">
      <!-- 帖子头部 -->
      <view class="post-header">
        <view class="post-avatar">{{item.avatar}}</view>
        <view class="post-user-info">
          <view class="post-username">{{item.username}}</view>
          <view class="post-time">{{item.time}}</view>
        </view>
        <view class="post-category-badge cat-{{item.category}}">
          {{item.category === 'question' ? '问命' : '分享'}}
        </view>
      </view>

      <!-- 标题 -->
      <view class="post-title">{{item.title}}</view>

      <!-- 内容预览 -->
      <view class="post-preview">{{item.content}}</view>

      <!-- 标签 -->
      <view class="post-tags" wx:if="{{item.tags.length > 0}}">
        <text class="post-tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="index">#{{tag}}</text>
      </view>

      <!-- 底部操作 -->
      <view class="post-footer">
        <view class="post-action" catchtap="likePost" data-id="{{item.id}}">
          <text class="action-icon {{item.liked ? 'liked' : ''}}">{{item.liked ? '❤️' : '🤍'}}</text>
          <text class="action-count">{{item.likes}}</text>
        </view>
        <view class="post-action">
          <text class="action-icon">💬</text>
          <text class="action-count">{{item.comments}}</text>
        </view>
        <view class="post-action">
          <text class="action-icon">↗️</text>
          <text class="action-count">分享</text>
        </view>
      </view>
    </view>

    <view class="loading-tip" wx:if="{{isLoading}}"><text>加载中...</text></view>
    <view class="no-more" wx:if="{{!hasMore && posts.length > 0}}"><text>— 已经到底了 —</text></view>
    <view class="empty-tip" wx:if="{{!isLoading && posts.length === 0}}">
      <text class="empty-icon">📭</text>
      <text class="empty-text">还没有帖子，来发第一贴吧</text>
    </view>
  </view>

  <!-- 发帖按钮 -->
  <view class="fab-btn" bindtap="showCreatePost">+</view>

  <!-- 发帖弹窗 -->
  <view class="modal-overlay" wx:if="{{showPostModal}}" bindtap="closePostModal">
    <view class="modal-box" catchtap="">
      <view class="modal-title">发布帖子</view>
      <view class="form-item">
        <view class="form-label">分类</view>
        <picker mode="selector" range="['分享心得', '问命求测']" bindchange="onCategoryChange">
          <view class="form-picker">{{postForm.category === 'experience' ? '分享心得' : '问命求测'}}</view>
        </picker>
      </view>
      <view class="form-item">
        <view class="form-label">标题</view>
        <input class="form-input" placeholder="请输入标题（5-30字）" maxlength="30"
               bindinput="onPostTitleInput" value="{{postForm.title}}" />
      </view>
      <view class="form-item">
        <view class="form-label">内容</view>
        <textarea class="form-textarea" placeholder="分享你的命理经验或问题..." maxlength="500"
                  bindinput="onPostContentInput" value="{{postForm.content}}" />
      </view>
      <view class="modal-actions">
        <button class="btn-cancel" bindtap="closePostModal">取消</button>
        <button class="btn-submit" bindtap="submitPost">发布</button>
      </view>
    </view>
  </view>
</view>
