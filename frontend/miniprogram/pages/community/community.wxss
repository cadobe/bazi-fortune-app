.container { padding: 0 0 120rpx 0; background: #F5F5DC; min-height: 100vh; }
.page-title { font-size: 40rpx; font-weight: bold; color: #8B4513; text-align: center; padding: 40rpx 0 20rpx; }

/* Tab栏 */
.tab-bar {
  display: flex; background: #fff;
  border-bottom: 2rpx solid #f0e8d8;
  position: sticky; top: 0; z-index: 10;
}
.tab-item {
  flex: 1; text-align: center; padding: 24rpx 0;
  font-size: 28rpx; color: #999;
}
.tab-item.active { color: #8B4513; border-bottom: 4rpx solid #8B4513; font-weight: bold; }

/* 帖子列表 */
.post-list { padding: 16rpx 24rpx; }
.post-card {
  background: #fff; border-radius: 20rpx; padding: 32rpx;
  margin-bottom: 20rpx; box-shadow: 0 2rpx 12rpx rgba(139,69,19,0.08);
}
.post-card:active { opacity: 0.9; }

/* 帖子头部 */
.post-header { display: flex; align-items: center; gap: 16rpx; margin-bottom: 20rpx; }
.post-avatar {
  width: 72rpx; height: 72rpx; border-radius: 50%; background: #FFF8DC;
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx; border: 2rpx solid #D2B48C; line-height: 72rpx; text-align: center;
}
.post-user-info { flex: 1; }
.post-username { font-size: 28rpx; font-weight: bold; color: #333; }
.post-time { font-size: 22rpx; color: #999; margin-top: 4rpx; }
.post-category-badge { font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 20rpx; }
.cat-question { background: #fff3e0; color: #e65100; }
.cat-experience { background: #e8f5e9; color: #2e7d32; }

/* 帖子内容 */
.post-title { font-size: 32rpx; font-weight: bold; color: #222; margin-bottom: 16rpx; line-height: 1.4; }
.post-preview {
  font-size: 26rpx; color: #666; line-height: 1.6;
  overflow: hidden; display: -webkit-box;
  -webkit-line-clamp: 2; -webkit-box-orient: vertical;
  margin-bottom: 16rpx;
}
.post-tags { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 20rpx; }
.post-tag { font-size: 22rpx; color: #8B4513; background: rgba(139,69,19,0.08); padding: 4rpx 14rpx; border-radius: 20rpx; }

/* 底部操作 */
.post-footer { display: flex; gap: 40rpx; padding-top: 20rpx; border-top: 1rpx solid #f5f5f5; }
.post-action { display: flex; align-items: center; gap: 8rpx; }
.action-icon { font-size: 28rpx; }
.action-count { font-size: 24rpx; color: #999; }

/* 加载/空状态 */
.loading-tip, .no-more, .empty-tip { text-align: center; padding: 40rpx; color: #aaa; font-size: 24rpx; }
.empty-tip { display: flex; flex-direction: column; gap: 16rpx; align-items: center; padding: 80rpx 0; }
.empty-icon { font-size: 80rpx; }
.empty-text { font-size: 28rpx; }

/* 发帖FAB */
.fab-btn {
  position: fixed; right: 40rpx; bottom: 160rpx;
  width: 100rpx; height: 100rpx; border-radius: 50%;
  background: #8B4513; color: #fff;
  font-size: 56rpx; line-height: 100rpx; text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(139,69,19,0.4);
  z-index: 100;
}

/* 发帖弹窗 */
.modal-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5); z-index: 200;
  display: flex; align-items: flex-end;
}
.modal-box {
  background: #fff; border-radius: 32rpx 32rpx 0 0;
  padding: 48rpx 40rpx 60rpx; width: 100%;
}
.modal-title { font-size: 36rpx; font-weight: bold; color: #8B4513; text-align: center; margin-bottom: 40rpx; }
.form-item { margin-bottom: 28rpx; }
.form-label { font-size: 26rpx; color: #555; margin-bottom: 12rpx; }
.form-input {
  width: 100%; border: 2rpx solid #e0e0e0; border-radius: 12rpx;
  padding: 24rpx; font-size: 28rpx; color: #333; box-sizing: border-box;
}
.form-picker {
  border: 2rpx solid #e0e0e0; border-radius: 12rpx;
  padding: 24rpx; font-size: 28rpx; color: #333;
}
.form-textarea {
  width: 100%; border: 2rpx solid #e0e0e0; border-radius: 12rpx;
  padding: 24rpx; font-size: 28rpx; color: #333; min-height: 180rpx;
  box-sizing: border-box;
}
.modal-actions { display: flex; gap: 24rpx; margin-top: 32rpx; }
.btn-cancel {
  flex: 1; padding: 28rpx; border-radius: 16rpx; font-size: 30rpx;
  background: #f5f5f5; color: #666; border: none;
}
.btn-submit {
  flex: 2; padding: 28rpx; border-radius: 16rpx; font-size: 30rpx;
  background: #8B4513; color: #fff; border: none;
}
