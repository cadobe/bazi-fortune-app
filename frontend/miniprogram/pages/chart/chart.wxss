.container {
  padding: 30rpx;
  background: #F5F5DC;
  min-height: 100vh;
}
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}
.page-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #8B4513;
}
.btn-new {
  background: #8B4513;
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  border: none;
}
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(139,69,19,0.1);
}
.loading-wrap {
  text-align: center;
  padding: 80rpx 0;
}
.empty-state {
  text-align: center;
  padding: 100rpx 0;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}
.empty-text {
  font-size: 32rpx;
  color: #8B4513;
  margin-bottom: 10rpx;
}
.empty-sub {
  font-size: 26rpx;
  color: #999;
}
.chart-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.chart-info {
  flex: 1;
}
.chart-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #3d1a00;
  margin-bottom: 8rpx;
}
.chart-bazi {
  font-size: 28rpx;
  color: #8B4513;
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
}
.chart-date {
  font-size: 22rpx;
  color: #bbb;
}
.btn-delete {
  background: transparent;
  color: #c0392b;
  font-size: 26rpx;
  border: 1rpx solid #c0392b;
  border-radius: 30rpx;
  padding: 10rpx 24rpx;
}
